<style>
:root{
  --gold:#D4AF37;
  --gold-soft:rgba(212,175,55,.15);
  --void:#ffffff;
  --slate:#ffffff;
  --slate-2:#f8fafc;
  --text:#111827;
  --muted:#6b7280;
  --line:#e5e7eb;
  --shadow:rgba(0, 0, 0, 0.06);
  --btn-dark:#111827;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;font-family:'Lato',sans-serif;background:var(--slate-2);color:var(--text);
  -webkit-font-smoothing:antialiased;
}
button,input,textarea,select{font-family:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ---------- HERO ---------- */
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;overflow:hidden;background:var(--void);}
.hero-media{position:absolute;inset:0;z-index:0}
.hero-media video{width:100%;height:100%;object-fit:cover;opacity:.15}
.hero-media::after{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(120% 80% at 50% 0%,rgba(255,255,255,.3) 0%,rgba(255,255,255,.9) 55%,var(--void) 100%),
    linear-gradient(180deg,rgba(255,255,255,.5),rgba(255,255,255,1));
}
.hero-inner{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;padding:90px 20px 40px;max-width:900px;margin:0 auto;width:100%}

.wordmark{font-family:'Cinzel',serif;color:var(--text);font-size:clamp(2.6rem,7vw,4.4rem);
  font-weight:700;letter-spacing:.16em;margin:0 0 6px;}
.kicker{font-family:'Cinzel',serif;font-size:.8rem;letter-spacing:.35em;color:var(--gold);margin:0 0 28px;font-weight:700;}
.hero-line{font-size:clamp(1.3rem,3.4vw,2rem);line-height:1.45;font-weight:300;margin:0 auto 10px;max-width:22ch;color:#374151;}
.hero-line b{font-weight:700;color:var(--text)}
.hero-sub{color:var(--muted);font-weight:400;max-width:56ch;margin:0 auto 34px;line-height:1.6;font-size:1.1rem;}

/* ask bar */
.askbar{display:flex;gap:10px;width:100%;max-width:620px;margin:0 auto;
  background:rgba(255,255,255,.95);backdrop-filter:blur(12px);
  border:1px solid var(--line);border-radius:14px;padding:10px 10px 10px 18px;
  box-shadow:0 12px 30px rgba(0,0,0,.05),0 0 0 1px rgba(0,0,0,.02) inset}
.askbar input{flex:1;background:none;border:none;color:var(--text);font-size:1.05rem;outline:none;min-width:0}
.askbar input::placeholder{color:#9ca3af}
.askbar button{background:var(--btn-dark);color:#ffffff;border:none;border-radius:9px;
  padding:13px 24px;font-weight:700;letter-spacing:.06em;cursor:pointer;transition:background .25s,transform .25s}
.askbar button:hover{background:var(--gold);color:#0b0e14;transform:translateY(-1px)}

.chips{display:flex;flex-wrap:wrap;gap:9px;justify-content:center;margin-top:22px;max-width:640px}
.chip{background:#ffffff;border:1px solid var(--line);color:var(--muted);
  padding:8px 15px;border-radius:999px;font-size:.87rem;cursor:pointer;transition:.25s;box-shadow:0 2px 4px var(--shadow);}
.chip:hover{border-color:var(--gold);color:var(--btn-dark);background:var(--gold-soft)}

.scroll-hint{position:relative;z-index:2;text-align:center;padding-bottom:26px;color:#9ca3af;font-size:.75rem;letter-spacing:.25em;font-weight:700;}

/* ---------- SHELL ---------- */
.shell{max-width:1180px;margin:0 auto;padding:0 20px 90px}
.section-head{font-family:'Cinzel',serif;font-size:1.5rem;letter-spacing:.12em;margin:70px 0 6px;color:var(--text);}
.section-head span{color:var(--gold)}
.section-note{color:var(--muted);font-weight:400;margin:0 0 26px}

/* ---------- CHAT ---------- */
.chat{display:grid;grid-template-columns:1fr 340px;gap:22px;align-items:start}
.panel{background:var(--slate);border:1px solid var(--line);border-radius:16px;box-shadow:0 8px 30px var(--shadow);}
.chat-log{padding:24px;min-height:340px;max-height:70vh;overflow-y:auto;scroll-behavior:smooth}
.chat-log::-webkit-scrollbar{width:7px}
.chat-log::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:4px}

.msg{margin-bottom:20px;max-width:92%}
.msg.you{margin-left:auto;text-align:right}
.bubble{display:inline-block;padding:13px 17px;border-radius:14px;line-height:1.65;font-weight:400}
.msg.bot .bubble{background:var(--slate-2);border:1px solid var(--line);border-top-left-radius:4px;color:var(--text);}
.msg.you .bubble{background:var(--btn-dark);border:1px solid var(--btn-dark);color:#ffffff;border-bottom-right-radius:4px}
.who{font-size:.68rem;letter-spacing:.22em;color:#9ca3af;margin-bottom:7px;font-family:'Cinzel',serif}

.typing span{display:inline-block;width:6px;height:6px;margin:0 2px;background:var(--gold);border-radius:50%;animation:blink 1.2s infinite}
.typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,60%,100%{opacity:.25}30%{opacity:1}}

/* product results */
.results{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px;margin-top:14px}
.card{background:var(--void);border:1px solid var(--line);border-radius:12px;overflow:hidden;
  display:flex;flex-direction:column;transition:border-color .25s, box-shadow .25s;box-shadow:0 2px 8px var(--shadow);}
.card:hover{border-color:var(--gold);box-shadow:0 6px 16px rgba(0,0,0,.08);}
.card .thumb{aspect-ratio:1;background:#f3f4f6;display:block;width:100%;object-fit:cover}
.card .body{padding:13px 14px 14px;display:flex;flex-direction:column;gap:7px;flex:1}
.card h4{margin:0;font-size:.95rem;font-weight:700;line-height:1.35;color:var(--text);}
.card .cat{font-size:.72rem;color:#6b7280;letter-spacing:.08em;text-transform:uppercase;}
.card .meta{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-top:auto;padding-top:6px}
.card .price{font-size:1.15rem;color:var(--btn-dark);font-weight:700}
.card .price small{font-size:.66rem;color:var(--muted);font-weight:400;display:block;letter-spacing:.05em}
.card .moq{font-size:.75rem;color:var(--muted);text-align:right;line-height:1.4}
.card button{margin:0 14px 14px;background:transparent;border:1px solid var(--line);color:var(--text);
  padding:9px;border-radius:8px;cursor:pointer;font-size:.8rem;font-weight:700;letter-spacing:.06em;transition:.25s}
.card button:hover{background:var(--gold);color:#0b0e14;border-color:var(--gold);}
.card button.added{background:var(--slate-2);border-color:var(--line);color:#9ca3af;cursor:default}

.chat-input{display:flex;gap:10px;border-top:1px solid var(--line);padding:14px;background:#ffffff;border-bottom-left-radius:16px;border-bottom-right-radius:16px;}
.chat-input input{flex:1;background:var(--slate-2);border:1px solid var(--line);border-radius:9px;
  padding:13px 15px;color:var(--text);outline:none;min-width:0}
.chat-input input:focus{border-color:var(--gold);background:#ffffff;}
.chat-input button{background:var(--btn-dark);color:#ffffff;border:none;border-radius:9px;padding:0 20px;font-weight:700;cursor:pointer;transition:background .25s;}
.chat-input button:hover{background:var(--gold);color:#0b0e14;}

/* ---------- QUOTE LIST ---------- */
.quote{position:sticky;top:20px;padding:20px}
.quote h3{font-family:'Cinzel',serif;font-size:1rem;letter-spacing:.14em;margin:0 0 4px;color:var(--text);}
.quote .hint{color:var(--muted);font-size:.82rem;font-weight:400;margin:0 0 16px;line-height:1.6}
.qlist{display:flex;flex-direction:column;gap:10px;max-height:44vh;overflow-y:auto}
.qlist::-webkit-scrollbar{width:5px}
.qlist::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:4px}
.qempty{border:1px dashed #d1d5db;background:#f9fafb;border-radius:10px;padding:26px 16px;text-align:center;color:#6b7280;font-size:.85rem;line-height:1.7}
.qitem{background:var(--void);border:1px solid var(--line);border-radius:10px;padding:11px 12px;box-shadow:0 2px 6px var(--shadow);}
.qitem .top{display:flex;justify-content:space-between;gap:8px}
.qitem strong{font-size:.85rem;font-weight:700;line-height:1.3}
.qitem .rm{background:none;border:none;color:#9ca3af;cursor:pointer;font-size:1.2rem;line-height:1;padding:0 2px}
.qitem .rm:hover{color:#ef4444}
.qitem .row{display:flex;align-items:center;justify-content:space-between;margin-top:9px;gap:8px}
.qitem label{font-size:.7rem;color:var(--muted);letter-spacing:.08em}
.qitem input{width:92px;background:#ffffff;border:1px solid var(--line);border-radius:6px;
  color:var(--text);padding:7px 9px;font-size:.85rem;text-align:right}
.qitem input:focus{border-color:var(--gold);}
.qitem .sum{font-size:.8rem;color:var(--btn-dark);font-weight:700;}
.qtotal{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:16px;padding-top:14px;font-size:.9rem}
.qtotal b{color:var(--btn-dark);font-size:1.15rem}
.qsend{width:100%;margin-top:14px;background:var(--btn-dark);color:#ffffff;border:none;border-radius:9px;
  padding:14px;font-weight:700;letter-spacing:.07em;cursor:pointer;transition:background .25s}
.qsend:disabled{background:#e5e7eb;color:#9ca3af;cursor:not-allowed}
.qsend:not(:disabled):hover{background:var(--gold);color:#0b0e14;}

/* ---------- MODAL ---------- */
.modal{position:fixed;inset:0;background:rgba(255,255,255,.85);backdrop-filter:blur(6px);
  display:none;align-items:center;justify-content:center;padding:20px;z-index:60}
.modal.open{display:flex}
.modal-card{background:var(--void);border:1px solid var(--line);border-radius:16px;
  padding:30px;width:100%;max-width:430px;max-height:90vh;overflow-y:auto;box-shadow:0 25px 50px -12px rgba(0,0,0,0.15);}
.modal-card h3{font-family:'Cinzel',serif;margin:0 0 6px;letter-spacing:.1em;font-size:1.2rem;color:var(--text);}
.modal-card p{color:var(--muted);font-weight:400;font-size:.88rem;margin:0 0 20px;line-height:1.7}
.field{margin-bottom:13px}
.field label{display:block;font-size:.72rem;letter-spacing:.14em;color:var(--muted);margin-bottom:6px;text-transform:uppercase;}
.field input,.field textarea{width:100%;background:#f9fafb;border:1px solid var(--line);border-radius:8px;
  padding:12px;color:var(--text);outline:none;transition:border-color .2s;}
.field input:focus,.field textarea:focus{border-color:var(--gold);background:#ffffff;}
.modal-actions{display:flex;gap:10px;margin-top:20px}
.modal-actions button{flex:1;padding:13px;border-radius:9px;font-weight:700;cursor:pointer;letter-spacing:.06em}
.btn-ghost{background:transparent;border:1px solid var(--line);color:var(--text);transition:background .2s;}
.btn-ghost:hover{background:#f3f4f6;}
.btn-gold{background:var(--btn-dark);border:none;color:#ffffff;transition:background .2s;}
.btn-gold:hover{background:var(--gold);color:#0b0e14;}

/* ---------- FOOTER ---------- */
.foot{border-top:1px solid var(--line);padding:46px 20px;text-align:center;background:#ffffff;}
.foot .links{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-bottom:22px}
.foot a{display:inline-flex;align-items:center;gap:9px;color:var(--text);text-decoration:none;
  background:#ffffff;border:1px solid var(--line);padding:11px 18px;border-radius:9px;font-size:.92rem;transition:.25s;box-shadow:0 2px 4px var(--shadow);}
.foot a:hover{border-color:var(--gold);color:var(--btn-dark);background:var(--gold-soft);}
.foot svg{width:17px;height:17px;fill:var(--gold)}
.foot small{color:#6b7280;letter-spacing:.14em;font-size:.72rem}

@media (max-width:880px){
  .chat{grid-template-columns:1fr}
  .quote{position:static}
  .chat-log{max-height:none}
}
</style>
</head>
<body>

<!-- ===================== HERO ===================== -->
<header class="hero">
