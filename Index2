<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Muziris | Source inventory that keeps your margins green</title>
<meta name="description" content="Sourcing for Canadian Amazon FBA, Etsy, Faire, Shopify and social sellers. See landed cost, MOQ and margin on verified India-made products in seconds.">
<link rel="icon" type="image/png" href="MC.svg">

<script async src="https://www.googletagmanager.com/gtag/js?id=G-GBXY659LSC"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-GBXY659LSC');
</script>

<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --ink:#12151A;
  --muted:#5B6470;
  --faint:#8B93A0;
  --line:#E7E5DE;
  --paper:#FFFFFF;
  --sand:#F7F5F0;
  --sand-2:#EFEDE5;
  --green:#1F7A4D;
  --green-deep:#155C3A;
  --green-wash:#EAF3EE;
  --shadow:0 20px 50px rgba(18,21,26,.06);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:'Space Grotesk',sans-serif}
button,input,textarea,select{font-family:inherit}
a{color:inherit}
:focus-visible{outline:2px solid var(--green);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}

/* ---------------- NAV ---------------- */
.nav{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{display:flex;align-items:center;gap:9px;font-weight:700;font-size:1.15rem;
  color:var(--ink);text-decoration:none;letter-spacing:-.01em}
.brand .dot{width:9px;height:9px;border-radius:50%;background:var(--green)}
.nav-links{display:flex;align-items:center;gap:28px}
.nav-links a{color:var(--muted);text-decoration:none;font-size:.92rem;font-weight:500;transition:color .2s}
.nav-links a:hover{color:var(--ink)}
.nav-cta{background:var(--green);color:#fff!important;padding:10px 18px;border-radius:8px;font-weight:600!important}
.nav-cta:hover{background:var(--green-deep)!important}
@media (max-width:760px){.nav-links a:not(.nav-cta){display:none}}

/* ---------------- HERO ---------------- */
.hero{position:relative;overflow:hidden;padding:64px 0 0;background:
  radial-gradient(60% 50% at 82% 8%,var(--green-wash) 0%,transparent 60%)}
.hero-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:50px;align-items:center;padding-bottom:70px}
.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--green);font-weight:600;
  font-size:.86rem;margin-bottom:20px}
.eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--green)}
h1.headline{font-size:clamp(2.2rem,4.4vw,3.4rem);font-weight:700;line-height:1.12;letter-spacing:-.02em;
  margin:0 0 22px;max-width:14ch;color:var(--ink)}
h1.headline .accent{color:var(--green)}
.hero-sub{font-size:1.08rem;line-height:1.7;color:var(--muted);max-width:46ch;margin:0 0 30px}

.platform-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:34px}
.platform-tag{border:1px solid var(--line);color:var(--muted);font-size:.82rem;font-weight:500;
  padding:7px 13px;border-radius:999px;background:#fff}

.askbar{display:flex;gap:8px;background:#fff;border:1px solid var(--line);border-radius:12px;
  padding:6px 6px 6px 16px;max-width:560px;box-shadow:var(--shadow)}
.askbar input{flex:1;background:none;border:none;color:var(--ink);font-size:1rem;outline:none;min-width:0}
.askbar input::placeholder{color:var(--faint)}
.askbar button{background:var(--green);color:#fff;border:none;border-radius:8px;padding:13px 22px;
  font-weight:600;cursor:pointer;transition:.2s;white-space:nowrap}
.askbar button:hover{background:var(--green-deep)}
.hero-hint{color:var(--faint);font-size:.82rem;margin-top:12px}

/* margin ticker card */
.ticker{background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px;box-shadow:var(--shadow)}
.ticker-label{font-size:.78rem;color:var(--muted);font-weight:600;margin-bottom:18px}
.ticker-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--line)}
.ticker-row:last-child{border-bottom:none}
.ticker-row .k{color:var(--muted);font-size:.88rem}
.ticker-row .v{font-family:'Space Grotesk';font-weight:600;font-size:1.15rem;color:var(--ink)}
.ticker-row .v.pos{color:var(--green)}
.ticker-product{font-size:.82rem;color:var(--muted);margin-top:16px;padding-top:16px;border-top:1px dashed var(--line)}
.ticker-product b{color:var(--ink);font-weight:600}

/* ---------------- SECTIONS ---------------- */
.section{padding:76px 0}
.section-tag{color:var(--green);font-weight:600;font-size:.86rem;margin-bottom:10px}
.section-h{font-size:clamp(1.6rem,3vw,2.1rem);font-weight:700;letter-spacing:-.02em;margin:0 0 14px;max-width:22ch}
.section-sub{color:var(--muted);font-size:1.02rem;line-height:1.7;max-width:60ch;margin:0 0 40px}

/* channel fit */
.channels{border-top:1px solid var(--line)}
.channel-row{display:grid;grid-template-columns:220px 1fr;gap:28px;padding:28px 0;border-bottom:1px solid var(--line)}
.channel-row h4{margin:0;font-size:1.15rem;font-weight:700;display:flex;align-items:center;gap:10px;color:var(--ink)}
.channel-row h4 svg{width:20px;height:20px;stroke:var(--green);fill:none;stroke-width:1.8}
.channel-row p{margin:0;color:var(--muted);line-height:1.7;max-width:62ch}
@media (max-width:680px){.channel-row{grid-template-columns:1fr;gap:8px}}

/* how it works */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.step{border-left:2px solid var(--line);padding-left:18px}
.step .num{font-family:'Space Grotesk';font-weight:700;font-size:1.6rem;color:var(--green);display:block;margin-bottom:10px}
.step h5{margin:0 0 8px;font-size:1.02rem;font-weight:700;color:var(--ink)}
.step p{margin:0;color:var(--muted);font-size:.92rem;line-height:1.65}
@media (max-width:860px){.steps{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.steps{grid-template-columns:1fr}}

/* ---------------- COPILOT ---------------- */
.copilot-wrap{background:var(--sand)}
.chat-shell{display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start}
.panel{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}
.chat-log{padding:22px;min-height:320px;max-height:66vh;overflow-y:auto}
.chat-log::-webkit-scrollbar{width:7px}
.chat-log::-webkit-scrollbar-thumb{background:var(--sand-2);border-radius:4px}

.msg{margin-bottom:20px;max-width:94%}
.msg.you{margin-left:auto}
.bubble{display:inline-block;padding:13px 16px;border-radius:12px;line-height:1.65;font-size:.95rem}
.msg.bot .bubble{background:var(--sand);border-top-left-radius:3px;color:var(--ink)}
.msg.you .bubble{background:var(--green);color:#fff;border-bottom-right-radius:3px}
.who{font-size:.7rem;font-weight:600;color:var(--faint);margin-bottom:6px}
.msg.you .who{text-align:right}

.typing span{display:inline-block;width:6px;height:6px;margin:0 2px;background:var(--green);border-radius:50%;animation:blink 1.2s infinite}
.typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,60%,100%{opacity:.25}30%{opacity:1}}

.results{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;margin-top:14px}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;
  display:flex;flex-direction:column;transition:border-color .2s,transform .2s,box-shadow .2s}
.card:hover{border-color:var(--green);transform:translateY(-2px);box-shadow:var(--shadow)}
.card .thumb{aspect-ratio:1;width:100%;object-fit:cover;background:var(--sand)}
.card .body{padding:13px 14px 4px;display:flex;flex-direction:column;gap:6px}
.card .cat{font-size:.7rem;color:var(--faint);font-weight:600}
.card h4{margin:0;font-size:.92rem;font-weight:700;line-height:1.35;color:var(--ink)}
.badges{display:flex;flex-wrap:wrap;gap:5px;margin:2px 0 4px}
.badge{font-size:.66rem;font-weight:600;color:var(--green);background:var(--green-wash);padding:3px 8px;border-radius:999px}
.card .meta{display:flex;justify-content:space-between;align-items:baseline;padding-top:4px}
.card .price{font-size:1.08rem;color:var(--green);font-weight:700}
.card .price small{display:block;font-size:.63rem;color:var(--faint);font-weight:500}
.card .moq{font-size:.72rem;color:var(--muted);text-align:right;line-height:1.4}
.margin-line{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);
  background:var(--sand);margin:8px 14px 0;padding:8px 10px;border-radius:8px}
.margin-line b{color:var(--ink)}
.card button{margin:10px 14px 14px;background:transparent;border:1px solid var(--green);color:var(--green);
  padding:9px;border-radius:8px;cursor:pointer;font-size:.8rem;font-weight:700;transition:.2s}
.card button:hover{background:var(--green);color:#fff}
.card button.added{background:var(--green-wash);border-color:var(--green);color:var(--green);cursor:default}

.chat-input{display:flex;gap:10px;border-top:1px solid var(--line);padding:14px}
.chat-input input{flex:1;background:var(--sand);border:1px solid transparent;border-radius:9px;
  padding:13px 15px;color:var(--ink);outline:none;min-width:0}
.chat-input input:focus{border-color:var(--green)}
.chat-input button{background:var(--green);color:#fff;border:none;border-radius:9px;padding:0 20px;font-weight:600;cursor:pointer}
.chat-input button:hover{background:var(--green-deep)}

/* quote sidebar */
.quote{position:sticky;top:88px;padding:20px}
.quote h3{font-size:1rem;font-weight:700;margin:0 0 4px;color:var(--ink)}
.quote .hint{color:var(--muted);font-size:.82rem;margin:0 0 16px;line-height:1.6}
.qlist{display:flex;flex-direction:column;gap:10px;max-height:40vh;overflow-y:auto}
.qempty{border:1px dashed var(--line);border-radius:10px;padding:26px 16px;text-align:center;color:var(--faint);font-size:.85rem;line-height:1.7}
.qitem{background:var(--sand);border-radius:10px;padding:11px 12px}
.qitem .top{display:flex;justify-content:space-between;gap:8px}
.qitem strong{font-size:.85rem;font-weight:700;line-height:1.3;color:var(--ink)}
.qitem .rm{background:none;border:none;color:var(--faint);cursor:pointer;font-size:1.1rem;line-height:1;padding:0 2px}
.qitem .rm:hover{color:#c0392b}
.qitem .row{display:flex;align-items:center;justify-content:space-between;margin-top:9px;gap:8px}
.qitem label{font-size:.68rem;color:var(--muted)}
.qitem input{width:88px;background:#fff;border:1px solid var(--line);border-radius:6px;
  color:var(--ink);padding:7px 9px;font-size:.85rem;text-align:right}
.qitem .sum{font-size:.78rem;color:var(--green);font-weight:600}
.qtotal{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:16px;padding-top:14px;font-size:.9rem}
.qtotal b{color:var(--green);font-size:1.1rem}
.qsend{width:100%;margin-top:14px;background:var(--green);color:#fff;border:none;border-radius:9px;
  padding:14px;font-weight:700;cursor:pointer;transition:.2s}
.qsend:disabled{background:var(--sand-2);color:var(--faint);cursor:not-allowed}
.qsend:not(:disabled):hover{background:var(--green-deep)}

@media (max-width:880px){.chat-shell{grid-template-columns:1fr}.quote{position:static}.chat-log{max-height:none}}

/* ---------------- MODAL ---------------- */
.modal{position:fixed;inset:0;background:rgba(18,21,26,.5);backdrop-filter:blur(4px);
  display:none;align-items:center;justify-content:center;padding:20px;z-index:60}
.modal.open{display:flex}
.modal-card{background:#fff;border-radius:16px;padding:30px;width:100%;max-width:430px;
  max-height:90vh;overflow-y:auto;box-shadow:0 30px 80px rgba(18,21,26,.25)}
.modal-card h3{margin:0 0 6px;font-size:1.25rem;font-weight:700;color:var(--ink)}
.modal-card p{color:var(--muted);font-size:.88rem;margin:0 0 20px;line-height:1.7}
.field{margin-bottom:13px}
.field label{display:block;font-size:.75rem;font-weight:600;color:var(--muted);margin-bottom:6px}
.field input,.field textarea,.field select{width:100%;background:var(--sand);border:1px solid var(--line);
  border-radius:8px;padding:12px;color:var(--ink);outline:none}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--green)}
.modal-actions{display:flex;gap:10px;margin-top:20px}
.modal-actions button{flex:1;padding:13px;border-radius:9px;font-weight:700;cursor:pointer}
.btn-ghost{background:transparent;border:1px solid var(--line);color:var(--muted)}
.btn-green{background:var(--green);border:none;color:#fff}
.btn-green:hover{background:var(--green-deep)}

/* ---------------- FOOTER ---------------- */
.foot{background:var(--ink);color:#9aa3ae;padding:56px 0 30px}
.foot-top{display:flex;flex-wrap:wrap;gap:40px;justify-content:space-between;padding-bottom:36px;
  border-bottom:1px solid rgba(255,255,255,.1);margin-bottom:24px}
.foot-brand .brand{color:#fff;margin-bottom:10px}
.foot-brand .brand .dot{background:#33B673}
.foot-brand p{max-width:34ch;font-size:.9rem;line-height:1.7;margin:0}
.foot-links{display:flex;gap:12px;flex-wrap:wrap}
.foot-links a{display:inline-flex;align-items:center;gap:9px;color:#fff;text-decoration:none;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);padding:11px 16px;border-radius:9px;
  font-size:.88rem;font-weight:500;transition:.2s}
.foot-links a:hover{border-color:#33B673;color:#33B673}
.foot-links svg{width:16px;height:16px;fill:#33B673}
.foot small{display:block;color:#5b6470;font-size:.75rem;line-height:1.8}
</style>
</head>
<body>

<!-- ===================== NAV ===================== -->
<nav class="nav">
  <div class="wrap">
    <a href="#" class="brand"><span class="dot"></span>Muziris</a>
    <div class="nav-links">
      <a href="#channels">For sellers</a>
      <a href="#how">How it works</a>
      <a href="#copilot">Find products</a>
      <a href="join.html" class="nav-cta">Sell on Muziris</a>
    </div>
  </div>
</nav>

<!-- ===================== HERO ===================== -->
<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">Opening to Canadian sellers soon</div>
      <h1 class="headline">Source inventory that keeps your <span class="accent">margins green</span>.</h1>
      <p class="hero-sub">Built for Amazon FBA, Etsy, Faire, Shopify and social sellers who import from India. See landed cost, MOQ and factory pricing before you ever message a supplier.</p>

      <div class="platform-row">
        <span class="platform-tag">Amazon FBA</span>
        <span class="platform-tag">Etsy</span>
        <span class="platform-tag">Faire</span>
        <span class="platform-tag">Shopify</span>
        <span class="platform-tag">TikTok Shop</span>
      </div>

      <form class="askbar" id="heroForm">
        <input id="heroInput" type="text" placeholder="What are you selling right now?" aria-label="What are you selling?" autocomplete="off">
        <button type="submit">Show products</button>
      </form>
      <div class="hero-hint">Try "phone accessories," "candles," "pet supplies," "jewelry"</div>
    </div>

    <div class="ticker">
      <div class="ticker-label">Landed cost, worked out for you</div>
      <div class="ticker-row"><span class="k">Factory price</span><span class="v" id="tkFactory">C$1.10</span></div>
      <div class="ticker-row"><span class="k">Landed in Canada, all-in</span><span class="v" id="tkLanded">C$1.42</span></div>
      <div class="ticker-row"><span class="k">Typical resale on Etsy</span><span class="v pos" id="tkResale">C$9.99</span></div>
      <div class="ticker-row"><span class="k">Gross margin</span><span class="v pos" id="tkMargin">86%</span></div>
      <div class="ticker-product">Based on <b id="tkName">Bamboo Phone Stand</b> — recalculates for every product below.</div>
    </div>
  </div>
</header>

<!-- ===================== CHANNEL FIT ===================== -->
<section class="section" id="channels">
  <div class="wrap">
    <div class="section-tag">Built for how you sell</div>
    <h2 class="section-h">One catalog, priced for every channel you run.</h2>
    <p class="section-sub">Margins, pack sizes and lead times matter differently on each platform. We flag which of our factory listings tend to work best for yours.</p>

    <div class="channels">
      <div class="channel-row">
        <h4><svg viewBox="0 0 24 24"><path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/></svg>Amazon FBA</h4>
        <p>Case-pack friendly quantities, barcode-ready product photos, and factories used to FBA prep requirements — so you can go from sample to a live ASIN without a second sourcing trip.</p>
      </div>
      <div class="channel-row">
        <h4><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>Etsy &amp; Faire</h4>
        <p>Handmade-adjacent, small-batch and artisan-style goods with low MOQs, so you can test a new listing without tying up cash in inventory you haven't sold yet.</p>
      </div>
      <div class="channel-row">
        <h4><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM4 9h16M9 4v16"/></svg>Shopify</h4>
        <p>Private-label ready products with room for your branding — custom packaging, hang tags and inserts — for sellers building a brand buyers come back to directly.</p>
      </div>
      <div class="channel-row">
        <h4><svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 11-4-8"/><path d="M22 4l-10 8"/></svg>Social &amp; live selling</h4>
        <p>Photogenic, trend-ready products with fast turnaround, so you can restock what sells on TikTok or Instagram before the moment passes.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== HOW IT WORKS ===================== -->
<section class="section" id="how">
  <div class="wrap">
    <div class="section-tag">How it works</div>
    <h2 class="section-h">From idea to landed inventory, four steps.</h2>
    <div class="steps">
      <div class="step"><span class="num">01</span><h5>Tell us what you sell</h5><p>Search a product or browse by category — no account needed to look.</p></div>
      <div class="step"><span class="num">02</span><h5>See real factory listings</h5><p>MOQ, price per piece and landed CAD cost, from suppliers we've verified.</p></div>
      <div class="step"><span class="num">03</span><h5>Get samples &amp; firm pricing</h5><p>Add what you need to a quote list and we confirm freight and duties.</p></div>
      <div class="step"><span class="num">04</span><h5>Reorder without the back-and-forth</h5><p>Once a product's tested, repeat orders take minutes, not weeks.</p></div>
    </div>
  </div>
</section>

<!-- ===================== COPILOT + QUOTE ===================== -->
<section class="section copilot-wrap" id="copilot">
  <div class="wrap">
    <div class="section-tag">Sourcing copilot</div>
    <h2 class="section-h">Ask for a product. Get the numbers.</h2>
    <p class="section-sub">Every result shows MOQ, factory price and a margin estimate for your typical resale price — add anything that fits to your quote list.</p>

    <div class="chat-shell">
      <div class="panel">
        <div class="chat-log" id="log" aria-live="polite"></div>
        <form class="chat-input" id="chatForm">
          <input id="chatInput" type="text" placeholder="e.g. candles, jewelry, kitchen gadgets" aria-label="Message" autocomplete="off">
          <button type="submit">Send</button>
        </form>
      </div>

      <aside class="panel quote">
        <h3>Your quote list</h3>
        <p class="hint">These are indicative unit prices. Send the list and we confirm freight, duties and final landed cost within one business day.</p>
        <div class="qlist" id="qlist"></div>
        <div class="qtotal" id="qtotal" hidden><span>Indicative total</span><b id="qtotalVal">C$0</b></div>
        <button class="qsend" id="qsend" disabled>Request pricing</button>
      </aside>
    </div>
  </div>
</section>

<!-- ===================== MODAL ===================== -->
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-card">
    <h3 id="modalTitle">Where should we send it?</h3>
    <p>We'll reply with firm pricing, lead time and a sample plan.</p>
    <form id="quoteForm">
      <div class="field"><label for="fName">Your name</label><input id="fName" required></div>
      <div class="field"><label for="fCompany">Store / business name</label><input id="fCompany" placeholder="e.g. your Etsy shop or Shopify store name" required></div>
      <div class="field"><label for="fEmail">Email</label><input id="fEmail" type="email" required></div>
      <div class="field"><label for="fChannel">Where do you sell?</label>
        <select id="fChannel">
          <option>Amazon FBA</option><option>Etsy</option><option>Faire</option>
          <option>Shopify</option><option>TikTok Shop / Instagram</option><option>Other</option>
        </select>
      </div>
      <div class="field"><label for="fCountry">Delivery city, Canada</label><input id="fCountry" placeholder="Toronto, ON" required></div>
      <div class="field"><label for="fNotes">Anything else</label><textarea id="fNotes" rows="3" placeholder="Branding, packaging, target price, deadline"></textarea></div>
      <div class="modal-actions">
        <button type="button" class="btn-ghost" id="modalClose">Back</button>
        <button type="submit" class="btn-green">Send request</button>
      </div>
    </form>
  </div>
</div>

<!-- ===================== FOOTER ===================== -->
<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
