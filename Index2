<script>
/* =========================================================
   CONFIG
   ========================================================= */
const API_BASE   = '';                       // same origin. Use 'https://muziris-api.onrender.com' if split.
const WA_NUMBER  = '16366894747';            // fallback delivery if the API is down
let   PRODUCTS   = [];
let   CATEGORIES = {};
const quote      = new Map();

/* Demo rows so the page works before the catalog fills up.
   Delete this array once /api/catalog returns data. */
const DEMO = [
  {id:'D1',name:'Brass-Tip Gel Pen',category:'Stationery',subCategory:'Pens',moq:1000,priceCAD:0.42,image:''},
  {id:'D2',name:'Recycled Paper Barrel Pen',category:'Stationery',subCategory:'Pens',moq:2000,priceCAD:0.28,image:''},
  {id:'D3',name:'Metal Twist Executive Pen',category:'Stationery',subCategory:'Pens',moq:500,priceCAD:1.85,image:''},
  {id:'D4',name:'Bamboo Ballpoint Pen',category:'Stationery',subCategory:'Pens',moq:1500,priceCAD:0.61,image:''},
  {id:'D5',name:'Waffle Weave Cotton Towel',category:'Textiles & Apparel',subCategory:'Towels',moq:300,priceCAD:4.90,image:''},
  {id:'D6',name:'Turkish Cotton Bath Sheet',category:'Textiles & Apparel',subCategory:'Towels',moq:200,priceCAD:11.40,image:''},
  {id:'D7',name:'Whole Malabar Black Pepper 1kg',category:'Food & Spices',subCategory:'Spices',moq:100,priceCAD:13.75,image:''},
  {id:'D8',name:'Alleppey Turmeric Powder 500g',category:'Food & Spices',subCategory:'Spices',moq:150,priceCAD:5.20,image:''},
  {id:'D9',name:'Hand-Beaten Brass Planter',category:'Handicrafts',subCategory:'Decor',moq:100,priceCAD:17.60,image:''},
  {id:'D10',name:'Jute Webbing Tote Bag',category:'Handicrafts',subCategory:'Bags',moq:500,priceCAD:3.15,image:''},
  {id:'D11',name:'Stainless Steel Hose Clamp',category:'Industrial & Hardware',subCategory:'Fasteners',moq:5000,priceCAD:0.19,image:''},
  {id:'D12',name:'Cold-Pressed Coconut Oil 500ml',category:'Beauty & Wellness',subCategory:'Oils',moq:400,priceCAD:3.80,image:''}
];

/* =========================================================
   LOAD CATALOG
   ========================================================= */
async function loadCatalog(){
  try{
    const r = await fetch(API_BASE + '/api/catalog');
    const d = await r.json();
    if(d.success && d.products.length){
      PRODUCTS = d.products; CATEGORIES = d.categories || {};
      return;
    }
  }catch(e){ /* offline or not deployed yet */ }
  PRODUCTS = DEMO;
  CATEGORIES = DEMO.reduce((a,p)=>{ (a[p.category] ||= []).push(p.subCategory); return a; },{});
}

/* =========================================================
   SEARCH
   ========================================================= */
const SYNONYM = {pen:'pen',pens:'pen',biro:'pen',towel:'towel',towels:'towel',
  spice:'spice',spices:'spice',bag:'bag',bags:'bag',oil:'oil'};

function search(q){
  const raw = q.toLowerCase().trim();
  const words = raw.split(/[^a-z0-9]+/).filter(w => w.length > 2)
                   .map(w => SYNONYM[w] || w.replace(/(ies|es|s)$/,''));
  if(!words.length) return [];
  const hay = p => (p.name+' '+p.category+' '+p.subCategory+' '+(p.tagline||'')+' '+(p.desc||'')).toLowerCase();
  const scored = PRODUCTS.map(p => {
    const h = hay(p);
    return {p, score: words.reduce((s,w) => s + (h.includes(w) ? 1 : 0), 0)};
  }).filter(x => x.score > 0).sort((a,b) => b.score - a.score);
  return scored.map(x => x.p);
}

/* =========================================================
   CHAT RENDERING
   ========================================================= */
const log = document.getElementById('log');
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const money = n => 'C$' + Number(n).toFixed(2);

function placeholder(name){
  const letter = esc((name||'?').trim()[0] || '?').toUpperCase();
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
    <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f8fafc"/><stop offset="1" stop-color="#e5e7eb"/></linearGradient></defs>
    <rect width="200" height="200" fill="url(#g)"/>
    <text x="100" y="128" font-family="Georgia,serif" font-size="86" fill="#111827"
      fill-opacity="0.1" text-anchor="middle">${letter}</text></svg>`;
  return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
}

function say(who, html){
  const el = document.createElement('div');
  el.className = 'msg ' + (who === 'you' ? 'you' : 'bot');
  el.innerHTML = `<div class="who">${who === 'you' ? 'You' : 'Muziris'}</div><div class="bubble">${html}</div>`;
  log.appendChild(el);
  log.scrollTop = log.scrollHeight;
  return el;
}

function thinking(){
  const el = say('bot','<span class="typing"><span></span><span></span><span></span></span>');
  return el;
}

function cardHTML(p){
  const img = p.image ? esc(p.image) : placeholder(p.name);
  const inList = quote.has(String(p.id));
  return `<article class="card">
    <img class="thumb" src="${img}" alt="${esc(p.name)}" loading="lazy"
         onerror="this.src='${placeholder(p.name)}'">
    <div class="body">
      <div class="cat">${esc(p.category||'')}${p.subCategory ? ' · ' + esc(p.subCategory) : ''}</div>
      <h4>${esc(p.name)}</h4>
      <div class="meta">
        <div class="price">${money(p.priceCAD)}<small>per piece</small></div>
        <div class="moq">MOQ<br>${Number(p.moq||0).toLocaleString()}</div>
      </div>
    </div>
    <button data-add="${esc(p.id)}" class="${inList?'added':''}">${inList?'In your list':'Add to quote'}</button>
  </article>`;
}

function showResults(q){
  const hits = search(q);
  const el = thinking();
  setTimeout(() => {
    if(!hits.length){
      el.querySelector('.bubble').innerHTML =
        `I don't have <b>${esc(q)}</b> in the catalog yet, but we source to order.<br>
         Add a note in the quote list or <a href="https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Looking for: '+q)}"
         target="_blank" rel="noopener" style="color:var(--gold);font-weight:700;">message us on WhatsApp</a> and we'll find a factory for it.`;
      log.scrollTop = log.scrollHeight;
      return;
    }
    const line = hits.length === 1
      ? `Here's the one we have.`
      : `${hits.length} ${hits.length > 1 ? 'options' : 'option'} for <b>${esc(q)}</b>. Prices are per piece, delivered pricing confirmed once you send the list.`;
    el.querySelector('.bubble').innerHTML =
      line + `<div class="results">${hits.map(cardHTML).join('')}</div>`;
    log.scrollTop = log.scrollHeight;
  }, 450);
}

function ask(q){
  if(!q.trim()) return;
  say('you', esc(q));
  gtag && gtag('event','catalog_search',{search_term:q});
  showResults(q);
}

/* =========================================================
   QUOTE LIST
   ========================================================= */
const qlist = document.getElementById('qlist');
const qsend = document.getElementById('qsend');
const qtotal = document.getElementById('qtotal');

function renderQuote(){
  if(!quote.size){
    qlist.innerHTML = `<div class="qempty">Nothing here yet.<br>Search above and add what you need.</div>`;
    qsend.disabled = true; qtotal.hidden = true; return;
  }
  let total = 0;
  qlist.innerHTML = [...quote.values()].map(i => {
    const sum = i.qty * i.priceCAD; total += sum;
    return `<div class="qitem">
      <div class="top"><strong>${esc(i.name)}</strong>
        <button class="rm" data-rm="${esc(i.id)}" aria-label="Remove">×</button></div>
      <div class="row">
        <label for="q_${esc(i.id)}">Quantity (MOQ ${Number(i.moq).toLocaleString()})</label>
        <input id="q_${esc(i.id)}" type="number" min="${i.moq}" step="1" value="${i.qty}" data-qty="${esc(i.id)}">
      </div>
      <div class="row"><span class="sum">${money(i.priceCAD)} each</span><span class="sum">${money(sum)}</span></div>
    </div>`;
  }).join('');
  qtotal.hidden = false;
  document.getElementById('qtotalVal').textContent = money(total);
  qsend.disabled = false;
}

document.addEventListener('click', e => {
  const add = e.target.closest('[data-add]');
  if(add){
    const p = PRODUCTS.find(x => String(x.id) === add.dataset.add);
    if(p && !quote.has(String(p.id))){
      quote.set(String(p.id), {id:String(p.id), name:p.name, moq:p.moq||1, priceCAD:p.priceCAD, qty:p.moq||1});
      add.textContent = 'In your list'; add.classList.add('added');
      renderQuote();
      gtag && gtag('event','add_to_quote',{item_name:p.name});
    }
    return;
  }
  const rm = e.target.closest('[data-rm]');
  if(rm){
    quote.delete(rm.dataset.rm);
    document.querySelectorAll(`[data-add="${CSS.escape(rm.dataset.rm)}"]`).forEach(b => {
      b.textContent = 'Add to quote'; b.classList.remove('added');
    });
    renderQuote();
  }
});

qlist.addEventListener('change', e => {
  const f = e.target.closest('[data-qty]'); if(!f) return;
  const item = quote.get(f.dataset.qty); if(!item) return;
  item.qty = Math.max(item.moq, parseInt(f.value, 10) || item.moq);
  renderQuote();
});

/* =========================================================
   SUBMIT
   ========================================================= */
const modal = document.getElementById('modal');
qsend.addEventListener('click', () => { modal.classList.add('open'); document.getElementById('fName').focus(); });
document.getElementById('modalClose').addEventListener('click', () => modal.classList.remove('open'));
modal.addEventListener('click', e => { if(e.target === modal) modal.classList.remove('open'); });
document.addEventListener('keydown', e => { if(e.key === 'Escape') modal.classList.remove('open'); });

document.getElementById('quoteForm').addEventListener('submit', async e => {
  e.preventDefault();
  const payload = {
    name:    fName.value.trim(),
    company: fCompany.value.trim(),
    email:   fEmail.value.trim(),
    destination: fCountry.value.trim(),
    notes:   fNotes.value.trim(),
    items:   [...quote.values()].map(i => ({productId:i.id, name:i.name, qty:i.qty, indicativeCAD:i.priceCAD}))
  };

  let sent = false;
  try{
    const r = await fetch(API_BASE + '/api/quote-request', {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)
    });
    sent = r.ok;
  }catch(err){ sent = false; }

  modal.classList.remove('open');
  gtag && gtag('event','quote_request',{value: payload.items.length});

  if(sent){
    say('bot', `Thanks ${esc(payload.name)} — your list is with our sourcing desk. You'll have firm pricing at <b>${esc(payload.email)}</b> within one business day.`);
  }else{
    const text = `Quote request from ${payload.name} (${payload.company}, ${payload.email})\nShip to: ${payload.destination}\n\n` +
      payload.items.map(i => `• ${i.name} — ${i.qty.toLocaleString()} pcs`).join('\n') +
      (payload.notes ? `\n\nNotes: ${payload.notes}` : '');
    window.open(`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(text)}`,'_blank');
    say('bot', `Our form is offline right now, so I've opened WhatsApp with your list ready to send.`);
  }
  quote.clear(); renderQuote();
  document.querySelectorAll('[data-add].added').forEach(b => { b.textContent='Add to quote'; b.classList.remove('added'); });
  document.getElementById('quoteForm').reset();
});

/* =========================================================
   BOOT
   ========================================================= */
document.getElementById('heroForm').addEventListener('submit', e => {
  e.preventDefault();
  const v = heroInput.value; heroInput.value = '';
  document.querySelector('.shell').scrollIntoView({behavior:'smooth'});
  setTimeout(() => ask(v), 380);
});
document.getElementById('chatForm').addEventListener('submit', e => {
  e.preventDefault();
  const v = chatInput.value; chatInput.value = ''; ask(v);
});

(async function init(){
  await loadCatalog();

  const cats = Object.keys(CATEGORIES).slice(0,6);
  document.getElementById('heroChips').innerHTML =
    cats.map(c => `<button class="chip" type="button" data-q="${esc(c)}">${esc(c)}</button>`).join('');
  document.getElementById('heroChips').addEventListener('click', e => {
    const c = e.target.closest('.chip'); if(!c) return;
    document.querySelector('.shell').scrollIntoView({behavior:'smooth'});
    setTimeout(() => ask(c.dataset.q), 380);
  });

  say('bot',
    `Hello — I'm the Muziris sourcing desk.<br>
     Type a product name and I'll show what our factories make, with minimum order quantity and price per piece.<br><br>
     <div class="chips" style="justify-content:flex-start;margin-top:4px">${
       cats.map(c => `<button class="chip" type="button" data-add-q="${esc(c)}">${esc(c)}</button>`).join('')
     }</div>`);

  log.addEventListener('click', e => {
    const c = e.target.closest('[data-add-q]'); if(c) ask(c.dataset.addQ);
  });

  renderQuote();
})();
</script>
