<script>
/* =========================================================
   CONFIG
   ========================================================= */
const API_BASE  = '';
const WA_NUMBER = '16366894747';
let   PRODUCTS  = [];
let   CATEGORIES= {};
const quote     = new Map();
const MARKUP_X  = 3;   // used only for the illustrative "typical resale" figure

const CHANNEL_FIT = {
  'Home & Kitchen':['Etsy','Faire','Shopify'],
  'Handicrafts':['Etsy','Faire'],
  'Beauty & Wellness':['Shopify','TikTok Shop'],
  'Food & Spices':['Etsy','Shopify'],
  'Textiles & Apparel':['Etsy','Faire','Shopify'],
  'Industrial & Hardware':['Amazon FBA','Shopify'],
  'Packaging':['Amazon FBA','Shopify'],
  'Furniture':['Faire','Shopify'],
  'Pet Supplies':['Etsy','Shopify','Amazon FBA'],
  'General':['Amazon FBA','Shopify']
};
const channelsFor = cat => CHANNEL_FIT[cat] || CHANNEL_FIT.General;

/* Demo rows — SME-reseller relevant. Delete once /api/catalog has real data. */
const DEMO = [
  {id:'D1',name:'Bamboo Phone Stand',category:'Home & Kitchen',subCategory:'Desk accessories',moq:500,priceCAD:1.10,image:''},
  {id:'D2',name:'Marble-Effect Resin Coasters (Set of 4)',category:'Home & Kitchen',subCategory:'Tableware',moq:200,priceCAD:3.40,image:''},
  {id:'D3',name:'Hand-Block Printed Scrunchies (Pack of 6)',category:'Textiles & Apparel',subCategory:'Accessories',moq:300,priceCAD:1.85,image:''},
  {id:'D4',name:'Braided Leather Dog Collar',category:'Pet Supplies',subCategory:'Collars',moq:250,priceCAD:2.60,image:''},
  {id:'D5',name:'Brass Boho Drawer Knobs (Set of 6)',category:'Handicrafts',subCategory:'Hardware decor',moq:150,priceCAD:4.20,image:''},
  {id:'D6',name:'Copper Moscow Mule Mugs (Set of 2)',category:'Home & Kitchen',subCategory:'Barware',moq:100,priceCAD:6.90,image:''},
  {id:'D7',name:'Ayurvedic Rose Face Mist 100ml',category:'Beauty & Wellness',subCategory:'Skincare',moq:500,priceCAD:1.35,image:''},
  {id:'D8',name:'Chunky Knit Cotton Throw Blanket',category:'Textiles & Apparel',subCategory:'Home textiles',moq:100,priceCAD:9.80,image:''},
  {id:'D9',name:'Beaded Boho Keychains (Pack of 10)',category:'Handicrafts',subCategory:'Accessories',moq:400,priceCAD:2.10,image:''},
  {id:'D10',name:'Kraft Mailer Boxes 10x10x4"',category:'Packaging',subCategory:'Shipping supplies',moq:1000,priceCAD:0.38,image:''},
  {id:'D11',name:'Turmeric & Honey Soap Bar',category:'Beauty & Wellness',subCategory:'Bath & body',moq:600,priceCAD:0.95,image:''},
  {id:'D12',name:'Rattan Wall Hanging Mirror',category:'Furniture',subCategory:'Wall decor',moq:50,priceCAD:14.50,image:''}
];

/* =========================================================
   LOAD CATALOG
   ========================================================= */
async function loadCatalog(){
  try{
    const r = await fetch(API_BASE + '/api/catalog');
    const d = await r.json();
    if(d.success && d.products.length){ PRODUCTS = d.products; CATEGORIES = d.categories || {}; return; }
  }catch(e){}
  PRODUCTS = DEMO;
  CATEGORIES = DEMO.reduce((a,p)=>{ (a[p.category] ||= []).push(p.subCategory); return a; },{});
}

/* =========================================================
   HERO MARGIN TICKER
   ========================================================= */
function animateTicker(p){
  const landed = p.priceCAD * 1.28;               // illustrative freight+duty allowance
  const resale = Math.ceil(landed * MARKUP_X) - 0.01;
  const margin = Math.round((1 - landed / resale) * 100);
  document.getElementById('tkFactory').textContent = 'C$' + p.priceCAD.toFixed(2);
  document.getElementById('tkLanded').textContent  = 'C$' + landed.toFixed(2);
  document.getElementById('tkResale').textContent  = 'C$' + resale.toFixed(2);
  document.getElementById('tkMargin').textContent  = margin + '%';
  document.getElementById('tkName').textContent    = p.name;
}
function cycleTicker(){
  if(!PRODUCTS.length) return;
  let i = 0;
  animateTicker(PRODUCTS[0]);
  setInterval(() => { i = (i + 1) % Math.min(PRODUCTS.length, 6); animateTicker(PRODUCTS[i]); }, 4200);
}

/* =========================================================
   SEARCH
   ========================================================= */
const SYNONYM = {pen:'pen',pens:'pen',candle:'candle',candles:'candle',jewel:'jewel',jewelry:'jewel',
  jewellery:'jewel',mug:'mug',mugs:'mug',pet:'pet',dog:'dog',cat:'cat',phone:'phone',soap:'soap'};

function search(q){
  const raw = q.toLowerCase().trim();
  const words = raw.split(/[^a-z0-9]+/).filter(w => w.length > 2)
                   .map(w => SYNONYM[w] || w.replace(/(ies|es|s)$/,''));
  if(!words.length) return [];
  const hay = p => (p.name+' '+p.category+' '+p.subCategory+' '+(p.tagline||'')+' '+(p.desc||'')).toLowerCase();
  return PRODUCTS
    .map(p => ({p, score: words.reduce((s,w) => s + (hay(p).includes(w) ? 1 : 0), 0)}))
    .filter(x => x.score > 0).sort((a,b) => b.score - a.score).map(x => x.p);
}

/* =========================================================
   CHAT RENDERING
   ========================================================= */
const log = document.getElementById('log');
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const money = n => 'C$' + Number(n).toFixed(2);

function placeholder(name){
  const letter = esc((name||'?').trim()[0] || '?').toUpperCase();
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
    <rect width="200" height="200" fill="#F7F5F0"/>
    <text x="100" y="128" font-family="Georgia,serif" font-size="86" fill="#1F7A4D"
      fill-opacity="0.3" text-anchor="middle">${letter}</text></svg>`;
  return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
}

function say(who, html){
  const el = document.createElement('div');
  el.className = 'msg ' + (who === 'you' ? 'you' : 'bot');
  el.innerHTML = `<div class="who">${who === 'you' ? 'You' : 'Muziris'}</div><div class="bubble">${html}</div>`;
  log.appendChild(el); log.scrollTop = log.scrollHeight; return el;
}
function thinking(){ return say('bot','<span class="typing"><span></span><span></span><span></span></span>'); }

function cardHTML(p){
  const img = p.image ? esc(p.image) : placeholder(p.name);
  const inList = quote.has(String(p.id));
  const landed = p.priceCAD * 1.28;
  const resale = Math.ceil(landed * MARKUP_X) - 0.01;
  const margin = Math.round((1 - landed / resale) * 100);
  const badges = channelsFor(p.category).slice(0,3).map(c => `<span class="badge">${esc(c)}</span>`).join('');
  return `<article class="card">
    <img class="thumb" src="${img}" alt="${esc(p.name)}" loading="lazy" onerror="this.src='${placeholder(p.name)}'">
    <div class="body">
      <div class="cat">${esc(p.category||'')}${p.subCategory ? ' · ' + esc(p.subCategory) : ''}</div>
      <h4>${esc(p.name)}</h4>
      <div class="badges">${badges}</div>
      <div class="meta">
        <div class="price">${money(p.priceCAD)}<small>factory price</small></div>
        <div class="moq">MOQ<br>${Number(p.moq||0).toLocaleString()}</div>
      </div>
    </div>
    <div class="margin-line"><span>Landed ~${money(landed)}</span><span>Resale <b>${money(resale)}</b> · ${margin}% margin</span></div>
    <button data-add="${esc(p.id)}" class="${inList?'added':''}">${inList?'In your list':'Add to quote'}</button>
  </article>`;
}

function showResults(q){
  const hits = search(q);
  const el = thinking();
  setTimeout(() => {
    if(!hits.length){
      el.querySelector('.bubble').innerHTML =
        `I don't have <b>${esc(q)}</b> in the catalog yet, but we source to order.<br>
         <a href="https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Looking for: '+q)}"
         target="_blank" rel="noopener" style="color:var(--green);font-weight:600">Message us on WhatsApp</a> and we'll find a factory for it.`;
      log.scrollTop = log.scrollHeight; return;
    }
    const line = hits.length === 1 ? `Here's the one we have.`
      : `${hits.length} options for <b>${esc(q)}</b>. Landed cost and a typical resale margin are estimated below — adjust freely.`;
    el.querySelector('.bubble').innerHTML = line + `<div class="results">${hits.map(cardHTML).join('')}</div>`;
    log.scrollTop = log.scrollHeight;
  }, 420);
}

function ask(q){
  if(!q.trim()) return;
  say('you', esc(q));
  if(window.gtag) gtag('event','catalog_search',{search_term:q});
  showResults(q);
}

/* =========================================================
   QUOTE LIST
   ========================================================= */
const qlist = document.getElementById('qlist');
const qsend = document.getElementById('qsend');
const qtotal = document.getElementById('qtotal');

function renderQuote(){
  if(!quote.size){
    qlist.innerHTML = `<div class="qempty">Nothing here yet.<br>Search above and add what fits your store.</div>`;
    qsend.disabled = true; qtotal.hidden = true; return;
  }
  let total = 0;
  qlist.innerHTML = [...quote.values()].map(i => {
    const sum = i.qty * i.priceCAD; total += sum;
    return `<div class="qitem">
      <div class="top"><strong>${esc(i.name)}</strong><button class="rm" data-rm="${esc(i.id)}" aria-label="Remove">×</button></div>
      <div class="row"><label for="q_${esc(i.id)}">Qty (MOQ ${Number(i.moq).toLocaleString()})</label>
        <input id="q_${esc(i.id)}" type="number" min="${i.moq}" step="1" value="${i.qty}" data-qty="${esc(i.id)}"></div>
      <div class="row"><span class="sum">${money(i.priceCAD)} each</span><span class="sum">${money(sum)}</span></div>
    </div>`;
  }).join('');
  qtotal.hidden = false;
  document.getElementById('qtotalVal').textContent = money(total);
  qsend.disabled = false;
}

document.addEventListener('click', e => {
  const add = e.target.closest('[data-add]');
  if(add){
    const p = PRODUCTS.find(x => String(x.id) === add.dataset.add);
    if(p && !quote.has(String(p.id))){
      quote.set(String(p.id), {id:String(p.id), name:p.name, moq:p.moq||1, priceCAD:p.priceCAD, qty:p.moq||1});
      add.textContent = 'In your list'; add.classList.add('added');
      renderQuote();
      if(window.gtag) gtag('event','add_to_quote',{item_name:p.name});
    }
    return;
  }
  const rm = e.target.closest('[data-rm]');
  if(rm){
    quote.delete(rm.dataset.rm);
    document.querySelectorAll(`[data-add="${CSS.escape(rm.dataset.rm)}"]`).forEach(b => {
      b.textContent = 'Add to quote'; b.classList.remove('added');
    });
    renderQuote();
  }
});

qlist.addEventListener('change', e => {
  const f = e.target.closest('[data-qty]'); if(!f) return;
  const item = quote.get(f.dataset.qty); if(!item) return;
  item.qty = Math.max(item.moq, parseInt(f.value, 10) || item.moq);
  renderQuote();
});

/* =========================================================
   SUBMIT
   ========================================================= */
const modal = document.getElementById('modal');
qsend.addEventListener('click', () => { modal.classList.add('open'); document.getElementById('fName').focus(); });
document.getElementById('modalClose').addEventListener('click', () => modal.classList.remove('open'));
modal.addEventListener('click', e => { if(e.target === modal) modal.classList.remove('open'); });
document.addEventListener('keydown', e => { if(e.key === 'Escape') modal.classList.remove('open'); });

document.getElementById('quoteForm').addEventListener('submit', async e => {
  e.preventDefault();
  const payload = {
    name: fName.value.trim(), company: fCompany.value.trim(), email: fEmail.value.trim(),
    channel: fChannel.value, destination: fCountry.value.trim(), notes: fNotes.value.trim(),
    items: [...quote.values()].map(i => ({productId:i.id, name:i.name, qty:i.qty, indicativeCAD:i.priceCAD}))
  };
  let sent = false;
  try{
    const r = await fetch(API_BASE + '/api/quote-request', {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)
    });
    sent = r.ok;
  }catch(err){ sent = false; }

  modal.classList.remove('open');
  if(window.gtag) gtag('event','quote_request',{value: payload.items.length});

  if(sent){
    say('bot', `Thanks ${esc(payload.name)} — your list is with our sourcing desk. You'll have firm pricing at <b>${esc(payload.email)}</b> within one business day.`);
  }else{
    const text = `Quote request from ${payload.name} (${payload.company}, ${payload.channel})\nEmail: ${payload.email}\nShip to: ${payload.destination}\n\n` +
      payload.items.map(i => `• ${i.name} — ${i.qty.toLocaleString()} pcs`).join('\n') +
      (payload.notes ? `\n\nNotes: ${payload.notes}` : '');
    window.open(`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(text)}`,'_blank');
    say('bot', `Our form is offline right now, so I've opened WhatsApp with your list ready to send.`);
  }
  quote.clear(); renderQuote();
  document.querySelectorAll('[data-add].added').forEach(b => { b.textContent='Add to quote'; b.classList.remove('added'); });
  document.getElementById('quoteForm').reset();
});

/* =========================================================
   BOOT
   ========================================================= */
document.getElementById('heroForm').addEventListener('submit', e => {
  e.preventDefault();
  const v = heroInput.value; heroInput.value = '';
  document.getElementById('copilot').scrollIntoView({behavior:'smooth'});
  setTimeout(() => ask(v), 380);
});
document.getElementById('chatForm').addEventListener('submit', e => {
  e.preventDefault();
  const v = chatInput.value; chatInput.value = ''; ask(v);
});

(async function init(){
  await loadCatalog();
  cycleTicker();

  const cats = Object.keys(CATEGORIES).slice(0,6);
  say('bot',
    `Hey — I'm the Muziris sourcing copilot.<br>
     Tell me what you sell and I'll show factory listings with MOQ, price and an estimated margin for your store.<br><br>
     ${cats.map(c => `<button class="badge" style="cursor:pointer;border:none" data-add-q="${esc(c)}">${esc(c)}</button>`).join(' ')}`);

  log.addEventListener('click', e => {
    const c = e.target.closest('[data-add-q]'); if(c) ask(c.dataset.addQ);
  });

  renderQuote();
})();
</script>
</body>
